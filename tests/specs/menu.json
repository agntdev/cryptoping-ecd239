[
  {
    "name": "Команда меню показывает inline-навигацию",
    "steps": [
      {
        "send": { "text": "/menu" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Добро пожаловать. Выберите раздел в меню ниже.",
              "reply_markup": {
                "inline_keyboard": [
                  [{ "text": "🛍 Каталог", "callback_data": "shop:catalog" }],
                  [{ "text": "🛒 Корзина", "callback_data": "shop:cart" }],
                  [{ "text": "Список наблюдения", "callback_data": "watchlist:view" }],
                  [{ "text": "Оповещения", "callback_data": "alerts:menu" }],
                  [{ "text": "Проверить цену", "callback_data": "price:menu" }],
                  [{ "text": "Настройки", "callback_data": "user:settings" }]
                ]
              }
            }
          }
        ]
      }
    ]
  }
]
