[
  {
    "name": "/menu opens the main menu",
    "steps": [
      {
        "send": {"text": "/menu"},
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Добро пожаловать. Выберите раздел каталога или откройте избранное."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Главное меню содержит только пять разделов",
    "steps": [
      {
        "send": {"text": "/start"},
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Добро пожаловать. Выберите раздел каталога или откройте избранное.",
              "reply_markup": {
                "inline_keyboard": [
                  [{"text": "🛍 Каталог", "callback_data": "shop:catalog"}],
                  [{"text": "🛒 Корзина", "callback_data": "shop:cart"}],
                  [{"text": "📦 Мои заказы", "callback_data": "shop:orders"}],
                  [{"text": "👤 Профиль", "callback_data": "shop:profile"}],
                  [{"text": "ℹ️ Помощь", "callback_data": "shop:help"}]
                ]
              }
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Разделы открываются в том же сообщении",
    "steps": [
      {"send": {"callback": "shop:catalog"}, "expect": [{"method": "editMessageText", "payload": {"text": "Выберите раздел каталога."}}]},
      {"send": {"callback": "nav:back"}, "expect": [{"method": "editMessageText", "payload": {"text": "Добро пожаловать. Выберите раздел каталога или откройте избранное."}}]},
      {"send": {"callback": "shop:cart"}, "expect": [{"method": "editMessageText", "payload": {"text": "Корзина пуста. Откройте каталог, чтобы добавить товары."}}]},
      {"send": {"callback": "menu:main"}, "expect": [{"method": "editMessageText", "payload": {"text": "Добро пожаловать. Выберите раздел каталога или откройте избранное."}}]}
    ]
  }
]
