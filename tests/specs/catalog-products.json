      {"send":{"callback":"catalog:product:availability:in_stock"},"expect":[{"method":"answerCallbackQuery"},{"method":"sendMessage","payload":{"text":"Товар сохранён."}},{"method":"sendMessage","payload":{"text":"Товары в категории «Электроника»"}}]},
      {"send":{"callback":"catalog:product:view:electronics:desk-lamp"},"expect":[{"method":"answerCallbackQuery"},{"method":"sendPhoto"}]}
