[{"name":"Add a seeded coin and configure alerts","steps":[{"send":{"callback":"watchlist:add_coin"},"expect":[{"method":"sendMessage","payload":{"text":"Choose a coin, or tap Other ticker and send its symbol."}}]},{"send":{"callback":"watchlist:seed:BTC"},"expect":[{"method":"sendMessage","payload":{"text":"Bitcoin (BTC) is on your watchlist. Choose an alert or check its price."}}]},{"send":{"callback":"alert:price:BTC"},"expect":[{"method":"sendMessage","payload":{"text":"Enter the target price in USD."}}]},{"send":{"text":"100000"},"expect":[{"method":"sendMessage","payload":{"text":"Notify when BTC is:"}}]},{"send":{"callback":"alert:direction:above"},"expect":[{"method":"sendMessage","payload":{"text":"BTC price alert is set."}}]},{"send":{"callback":"alert:percent:BTC"},"expect":[{"method":"sendMessage","payload":{"text":"Choose a price change, or send a custom percent."}}]},{"send":{"callback":"alert:pct:5"},"expect":[{"method":"sendMessage","payload":{"text":"Choose the comparison window."}}]},{"send":{"callback":"alert:window:1h"},"expect":[{"method":"sendMessage","payload":{"text":"BTC alert set for a 5% move over 1h."}}]}]}]
